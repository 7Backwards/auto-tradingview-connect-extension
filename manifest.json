{
  "manifest_version": 2,
  "name": "TradingView Auto Connect",
  "version": "1.0.0",
  "description": "Automatically clicks \"Connect\" on TradingView's \"Session disconnected\" dialog.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tv-auto-connect@local",
      "strict_min_version": "91.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
